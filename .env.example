# Sao chép file này thành .env rồi đổi mật khẩu. KHÔNG commit file .env.
POSTGRES_DB=skillexchange
POSTGRES_USER=skillexchange
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Dùng từ tuần 3 (đăng nhập JWT, gửi mã xác thực email). Điền giá trị thật trong .env.
# Khóa ký JWT: chuỗi ngẫu nhiên tối thiểu 32 byte (256 bit).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
