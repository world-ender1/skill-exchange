# Sao chép file này thành .env rồi đổi mật khẩu. KHÔNG commit file .env.
POSTGRES_DB=skillexchange
POSTGRES_USER=skillexchange
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Dùng từ tuần 3 (đăng nhập JWT, gửi link xác thực email). Điền giá trị thật trong .env.
# Khóa ký JWT: chuỗi ngẫu nhiên tối thiểu 32 byte (256 bit).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Máy dev gửi thư tới Mailpit (D11): SMTP localhost:1025, không cần tài khoản.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Địa chỉ frontend, dùng để tạo link xác thực trong email (D5).
FRONTEND_URL=http://localhost:5173

# Tài khoản admin đầu tiên, tạo lúc khởi động nếu chưa có (D4).
ADMIN_EMAIL=admin@student.example.edu.vn
ADMIN_PASSWORD=change-me
